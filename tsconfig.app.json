{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "types": ["@types/google.maps"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "supabase/functions"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}